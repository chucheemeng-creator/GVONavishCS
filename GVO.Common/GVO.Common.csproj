<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 共用類別庫的版本號，和 GVONavish、發現物同步工具各自的版本號分開 -->
    <Version>1.0.1</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Bitmap、Graphics.CopyFromScreen、Icon 在 Windows Desktop 執行環境裡 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GVO.Common</AssemblyName>
    <RootNamespace>GVO.Common</RootNamespace>
    <!-- 讓這個專案在非 Windows 電腦上也能編譯（實際執行仍需 Windows） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
