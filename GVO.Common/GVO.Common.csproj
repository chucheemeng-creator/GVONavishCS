<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 共用類別庫的版本號，和 GVONavish、發現物同步工具各自的版本號分開 -->
    <Version>1.0.2</Version>
    <!-- net10.0：只有不依賴 Windows 的部分（IO，給 GVODiscoverySync.Core 用，Linux 也能編譯、跑測試）；
         net10.0-windows：加上截圖、找遊戲視窗（Capture） -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GVO.Common</AssemblyName>
    <RootNamespace>GVO.Common</RootNamespace>
    <!-- 讓這個專案在非 Windows 電腦上也能編譯（實際執行仍需 Windows） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- Bitmap、Graphics.CopyFromScreen、Icon 在 Windows Desktop 執行環境裡 -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Capture\**" />
  </ItemGroup>

</Project>
