<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 不依賴 Windows 的部分（Excel 讀寫、名稱比對、字形、讀取結果的推斷規則）：Linux、macOS 也能編譯、跑測試 -->
    <Version>0.2.68</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GVODiscoverySync.Core</AssemblyName>
    <RootNamespace>GVODiscoverySync</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 安全存檔（AtomicFile、BrokenFile） -->
    <ProjectReference Include="..\GVO.Common\GVO.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 內建的字形表（比對字形用；掃過所有分類學到的 1849 個字，包在 dll 裡） -->
    <EmbeddedResource Include="BuiltInGlyphs.json" LogicalName="BuiltInGlyphs.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- 直接改 xlsx 裡面的儲存格，其他內容（格式化條件、表格、註解）原封不動 -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>

</Project>
