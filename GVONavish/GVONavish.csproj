<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 版本號：發佈新版時只要改這裡（關於視窗會自動顯示） -->
    <Version>0.9.7</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>GVONavish</AssemblyName>
    <RootNamespace>GVONavish</RootNamespace>
    <!-- 讓這個專案在非 Windows 電腦上也能編譯（實際執行仍需 Windows） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- 找遊戲視窗、截圖、安全存檔等共用的部分 -->
    <ProjectReference Include="..\GVO.Common\GVO.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 地圖圖檔跟著程式一起複製到輸出資料夾 -->
    <None Update="map.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 海陸資料（規劃航線用，和顯示哪張地圖無關） -->
    <None Update="seamask.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
