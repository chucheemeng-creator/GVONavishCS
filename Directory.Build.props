<Project>

  <!-- 所有專案共用的設定（UseWindowsForms 不放這裡：GVO.Common 和 GVODiscoverySync.Core 有不是 Windows 的目標，只能各專案自己設定）。
       各專案自己的 .csproj 還是可以覆蓋這裡的值。 -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 讓專案在非 Windows 電腦上也能編譯（實際執行仍需 Windows） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
